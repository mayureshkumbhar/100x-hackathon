DATABASE_URL=PASTE_SUPABASE_POSTGRES_CONNECTION_STRING_HERE
GROQ_API_KEY=PASTE_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
# Apply db/supabase_schema.sql separately before deploying to Vercel.
# AUTO_INIT_SCHEMA defaults to false on Vercel and true locally.
# AUTO_INIT_SCHEMA=false
# EVAL_RUN_TIMEOUT_SECONDS defaults to 240 on Vercel and 0 (unlimited) locally.
# EVAL_RUN_TIMEOUT_SECONDS=240
